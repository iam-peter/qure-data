#N canvas 40 40 980 720 12;
#X text 20 12 Wavetable synth – draw a waveform and shape the envelope with QML nodes \, then play the keyboard., f 120;
#X text 20 36 Switch DSP on (Ctrl+/). Draw in the wave editor with the mouse – the array below it follows live., f 120;
#X obj 30 70 kbd 3 48;
#X obj 30 145 t l l;
#X obj 120 175 unpack f f;
#X obj 30 205 unpack f f;
#X obj 80 235 sel 0;
#X obj 30 300 f;
#X obj 140 300 f;
#X obj 30 330 ==;
#X obj 30 360 sel 1;
#X obj 30 390 f 400;
#X msg 30 420 0 \$1;
#X obj 140 265 t b b;
#X obj 140 330 t f f;
#X obj 140 360 mtof;
#X obj 230 300 t b b b;
#X obj 230 335 f 10;
#X obj 280 335 f 0.6;
#X obj 335 335 f 200;
#X obj 230 365 pack f f f;
#X msg 230 395 1 \$1 \, \$2 \$3 \$1;
#X obj 230 430 vline~;
#X text 30 455 Monophonic: a note-off only releases the note still held., f 30;
#X obj 420 300 adsr 10 200 0.6 400;
#X obj 420 435 unpack f f f f;
#X text 420 460 [adsr] (nodes/Adsr.qml): drag the handles. It stores A D S R in its arguments and sends them on load \, so the envelope works even when the node is off screen., f 42;
#X obj 420 70 wavedraw wavetable;
#X msg 690 70 sine;
#X msg 690 96 saw;
#X msg 690 122 square;
#X msg 690 148 triangle;
#X msg 690 174 random;
#X text 760 70 [wavedraw] (nodes/WaveDraw.qml) reads and writes the array "wavetable" with Qure.readArray() / Qure.writeArray()., f 28;
#N canvas 60 60 450 300 (subpatch) 0;
#X array wavetable 35 float 3;
#A 0 -0.3032 0 0.3032 0.545 0.6831 0.7071 0.6406 0.5319 0.4371 0.4 0.4371 0.5319 0.6406 0.7071 0.6831 0.545 0.3032 0 -0.3032 -0.545 -0.6831 -0.7071 -0.6406 -0.5319 -0.4371 -0.4 -0.4371 -0.5319 -0.6406 -0.7071 -0.6831 -0.545 -0.3032 0 0.3032;
#X coords 0 1 35 -1 256 70 1 0 0;
#X restore 420 205 graph;
#X text 690 215 the array the engine plays (35 = 32 + 3 guard points for [tabosc4~]), f 30;
#X obj 140 520 tabosc4~ wavetable;
