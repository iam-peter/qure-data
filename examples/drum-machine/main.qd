#X obj 510 410 t b f;
#X obj 510 440 v dm-hat;
#X obj 510 470 >>;
#X obj 510 500 & 1;
#X obj 510 530 sel 1;
#X obj 510 560 s hat;
#X obj 610 380 r hat;
#X obj 610 410 pad hat;
#X obj 610 485 s hat;
#X obj 510 600 r hat;
#X obj 510 630 hat;
#X obj 600 225 v dm-clap;
#X obj 750 380 r dm-step;
#X obj 750 410 t b f;
#X obj 750 440 v dm-clap;
#X obj 750 470 >>;
#X obj 750 500 & 1;
