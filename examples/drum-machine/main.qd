#N canvas 40 40 1000 860 12;
#X text 20 12 Drum machine – a step grid and drum pads written in QML drive four synthesized voices., f 120;
#X text 20 36 Play: switch DSP on (Ctrl+/) and tick "play". Draw in the grid. Click the pads., f 120;
#X obj 30 80 tgl 19 0 empty empty play 24 10 0 12 #fcfcfc #000000 #000000 0 1;
#X obj 110 70 knob 46 60 200 0 empty empty;
#X obj 180 70 knob 46 0 1 0 empty empty;
#X text 110 120 tempo;
#X text 185 120 volume;
#X obj 30 150 loadbang;
#X msg 30 180 120;
#X msg 80 180 0.8;
#X obj 110 150 expr 15000 / max(\$f1 \, 1);
#X floatatom 236 70 4 0 0 3 BPM - - 0;
#X obj 30 215 metro 125;
#X obj 30 245 f;
#X obj 70 245 + 1;
#X obj 30 275 mod 16;
#X obj 30 305 t f f;
#X obj 100 335 s dm-step;
#X obj 300 150 s dm-volume;
#X obj 360 70 stepgrid 4369 4112 21845 32896;
#X msg 290 70 clear;
#X msg 290 96 random;
#X obj 360 175 unpack f f f f;
#X text 700 70 [stepgrid] (nodes/StepGrid.qml) keeps each row as a 16-bit mask in its own arguments – they are saved with the patch and sent out when the patch loads. The engine keeps time: on every step [>>] and [& 1] test one bit of each row., f 34;
#X obj 360 205 v dm-kick;
#X obj 30 380 r dm-step;
#X obj 30 410 t b f;
#X obj 30 440 v dm-kick;
#X obj 30 470 >>;
#X obj 30 500 & 1;
#X obj 30 530 sel 1;
#X obj 30 560 s kick;
#X obj 130 380 r kick;
#X obj 130 410 pad kick;
#X obj 130 485 s kick;
#X obj 30 600 r kick;
#X obj 30 630 kick;
#X obj 440 225 v dm-snare;
