#X obj 750 560 s clap;
#X obj 850 380 r clap;
#X obj 850 410 pad clap;
#X obj 850 485 s clap;
#X obj 750 600 r clap;
#X obj 750 630 clap;
#X text 30 662 [pad] (nodes/TriggerPad.qml): click to play – it flashes whenever its voice plays., f 100;
#X text 30 680 kick.pd snare.pd hat.pd clap.pd are abstractions in this project folder., f 100;
