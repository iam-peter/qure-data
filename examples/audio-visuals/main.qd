#X obj 470 80 gfx.audio~ 512;
#X obj 470 115 gfx.shader scope 1.5 1.3 0.55;
#X obj 470 150 gfx.feedback 0.93 1.012 0.004;
#X obj 700 115 gfx.qml Scene.qml;
#X obj 470 215 gfx.mix 0.5;
#X obj 470 250 gfx.shader glow.frag 0.8 0.6;
#X obj 470 285 gfx.shader hue 0;
#X obj 470 320 gfx.window 640 360;
#X text 470 360 Purple cords carry textures. [gfx.audio~] turns the sound into a texture – the built-in scope effect draws it – [gfx.feedback] leaves trails. Scene.qml is a plain Qt Quick scene. glow.frag is this project's own shader: a vec4 effect(vec2 uv) function., f 60;
